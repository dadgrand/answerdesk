# answerdesk environment template — copy to `.env` and edit. Never commit `.env`.
#
# Precedence (docs/architecture.md §7):
#   CLI overrides > environment (ANSWERDESK_*/provider keys) > .env > configs/*.yaml > defaults
#
# Only profile `api` needs a key. Profiles `offline` (default) and `local` need none.

# --- Profile: offline (default, deterministic doubles) | api | local -----------
ANSWERDESK_PROFILE=offline

# --- Provider selection (no code change required) ------------------------------
# Presets: openai | openai_compatible | deepseek | openrouter | vllm | llama_cpp | ollama | fake
ANSWERDESK_LLM__PRESET=fake
# ANSWERDESK_LLM__BASE_URL=http://127.0.0.1:11434/v1
# ANSWERDESK_LLM__MODEL=qwen3:8b
# ANSWERDESK_LLM__TEMPERATURE=0.0
# ANSWERDESK_LLM__MAX_TOKENS=1024

# --- Provider API keys (profile api only) -------------------------------------
# Leave empty here; export them in your shell instead of storing them in a file.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# --- Embeddings / reranking (require `uv sync --extra local`) -----------------
# ANSWERDESK_EMBEDDING__BACKEND=bge_m3
# ANSWERDESK_RETRIEVAL__RERANK__ENABLED=true

# --- Logging ------------------------------------------------------------------
ANSWERDESK_LOGGING__LEVEL=INFO
ANSWERDESK_LOGGING__JSON_OUTPUT=true

# --- Optional: point at a different config file -------------------------------
# ANSWERDESK_CONFIG=configs/profiles/local.yaml
