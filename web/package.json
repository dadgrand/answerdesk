{
  "name": "answerdesk-console",
  "private": true,
  "version": "0.1.0",
  "description": "Operator console for answerdesk: queue, grounded answers with clickable citations, diagnostics and analytics.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "node scripts/screenshots.mjs",
    "mock:worker": "msw init public --save"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.0",
    "msw": "^2.4.9",
    "playwright": "^1.47.0",
    "typescript": "~5.6.2",
    "vite": "^5.4.3",
    "vitest": "^2.1.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
