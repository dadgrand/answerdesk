# Console build-time configuration (Vite exposes only VITE_* variables).
#
# ANSWERDESK service base URL. Empty means same origin (production build served by the
# service, or the Vite dev proxy). The Playwright screenshot script sets it to the real
# service it starts (http://127.0.0.1:8765).
# VITE_API_BASE=http://127.0.0.1:8765

# Force the MSW mock mode (no backend). The console also enables mock mode with `?mock=1`,
# which is handy for a quick look without rebuilding.
# VITE_USE_MOCK=true
